{
  "name": "cctvscan-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 14903 --strictPort",
    "build": "vue-tsc --noEmit --project tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run --maxWorkers=1",
    "test:e2e": "playwright test --workers=1",
    "e2e": "playwright test --workers=1",
    "preview": "vite preview --host 127.0.0.1 --port 14903 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "@quasar/extras": "2.1.0",
    "quasar": "2.35.2",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@quasar/vite-plugin": "2.0.2",
    "@types/node": "22.19.11",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "21.0.4",
    "sass-embedded": "1.107.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
